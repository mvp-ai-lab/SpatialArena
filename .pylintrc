[MAIN]
jobs=1
recursive=y
ignore=__pycache__,.git,.pytest_cache,.mypy_cache,spatialarena.egg-info
ignore-paths=
    spatialarena/eval/tnt_tools/.*

[MESSAGES CONTROL]
# Release linting focuses on code-breaking issues. The repository contains
# research scripts, CLIs, long data-conversion routines, and vendored evaluator
# code where default pylint style/docstring/complexity checks are too noisy to
# use as a release gate.
disable=
    C,
    R,
    W,
    duplicate-code,
    import-error,
    no-member,
    c-extension-no-member

[FORMAT]
max-line-length=120

[CLASSES]
# BenchmarkEvaluator.__init__ sets its state through reset() (also called to start over), so attributes first assigned
# there are defined at construction, not "outside __init__".
defining-attr-methods=__init__,__new__,setUp,asyncSetUp,__post_init__,reset
